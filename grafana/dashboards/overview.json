    {
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "description": "95th percentile request duration by service (API and Catalog record durations).",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
