    {
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Messages waiting in each work queue. During a load test the processing queue rises, then drains as the Worker replicas consume it.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (queue) (rabbitmq_queue_messages{queue=~\"video-validation|processing|notification\\\\.terminal\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
