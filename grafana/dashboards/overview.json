        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job) (rate(fiapx_http_requests_total{status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{job}} 5xx"
        }
